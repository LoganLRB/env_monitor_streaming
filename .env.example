ENVIRONMENT=local

# env_monitor_api — use host.docker.internal when running inside Docker
API_BASE_URL=http://host.docker.internal:8000

# Kafka — points to the kafka service in docker-compose
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=sensor.readings

# Redis — points to the redis service in docker-compose
REDIS_URL=redis://redis:6379

# SNS — not used in local dev; set in production via SSM
SNS_ALERT_TOPIC_ARN=
